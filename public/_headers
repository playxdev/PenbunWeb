# Security headers and cache policy for Cloudflare Pages.
#
# connect-src must list the PenbunAPI origin, or the browser blocks every
# call from core/api.ts before CORS is even consulted. The API is on
# DigitalOcean and this app is on Pages, so 'self' alone is never enough —
# it would only cover an API served from the Pages domain itself.
#
# The origin below must stay in step with PROD_ORIGIN in
# src/ts/core/config.ts. Changing one without the other breaks every
# deployed request, and the error names CSP rather than the mismatch.
#
# Local development does not read this file — tools/serve.mjs sends no CSP —
# so a missing origin here surfaces for the first time on a deployed build.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://starfish-app-zrucf.ondigitalocean.app; base-uri 'self'; form-action 'self'

# Cache policy.
#
# Nothing in assets/js or assets/css carries a content hash in its name:
# `main.js` is `main.js` in every build. So any cache lifetime at all means a
# returning visitor keeps running the previous deploy until it expires — the
# HTML is fresh, the code behind it is not, and the symptom is a page that
# renders its own loading state forever because the old bundle does not know
# the new route.
#
# These two therefore revalidate on every load. That costs one conditional
# request per file and answers 304 with no body whenever nothing changed,
# which is the right trade for a build with no cache busting. Images and
# fonts do not change under a fixed name, so they keep a real lifetime.
#
# A Cloudflare zone in front of Pages can override all of this: Browser Cache
# TTL rewrites Cache-Control on anything the edge caches, and its default of
# 4 hours is what www.phenbun.com served while penbunweb-1kq.pages.dev — the
# same deployment, no zone in front — served what this file says. Set the zone
# to "Respect Existing Headers", or the rules below are advisory only.

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/image/*
  Cache-Control: public, max-age=604800

# The Thai address tables (assets/data/th) change when a district is created
# or renamed — a few times a decade — and a stale copy costs nothing worse
# than an อำเภอ missing from a list, so they are cached for a day rather than
# revalidated on every form. A regeneration therefore reaches returning
# visitors within 24 hours, not instantly.

/assets/data/*
  Cache-Control: public, max-age=86400
