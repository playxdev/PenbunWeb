# Security headers and cache policy for Cloudflare Pages.
#
# connect-src must list the PenbunAPI origin, or the browser blocks every
# call from core/api.ts. 'self' alone is enough only when the API is served
# from this same origin (a proxy or a Pages Function in front of it).
# Otherwise append it, for example:
#
#   connect-src 'self' https://api.penbun.example
#
# Local development does not read this file — tools/serve.mjs sends no CSP —
# so a missing origin here surfaces for the first time on a deployed build.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=3600
